# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/devblog

# Secret key used to sign JWT tokens (use a long random string)
JWT_SECRET=your_jwt_secret_here

# Port the backend server runs on
PORT=3000

# Optional: enable Sequelize sync for local development
SEQUELIZE_SYNC=true

