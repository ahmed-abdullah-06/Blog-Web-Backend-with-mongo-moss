{
  "name": "devblog-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DevBlog Express API",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "prepare": "cd .. && backend/node_modules/.bin/husky backend/.husky",
    "test": "node --test test/sample.test.js",
    "secrets:check": "secretlint",
    "migrate": "sequelize-cli db:migrate --migrations-path migrations --config sequelize-config.js",
    "migrate:undo": "sequelize-cli db:migrate:undo:all --migrations-path migrations --config sequelize-config.js",
    "seed": "sequelize-cli db:seed:all --seeders-path seeders --config sequelize-config.js",
    "seed:undo": "sequelize-cli db:seed:undo:all --seeders-path seeders --config sequelize-config.js"
  },
  "dependencies": {
    "@sentry/node": "^10.70.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "lint-staged": {
    "*": "secretlint"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "nodemon": "^3.1.4",
    "secretlint": "^13.0.4"
  }
}
